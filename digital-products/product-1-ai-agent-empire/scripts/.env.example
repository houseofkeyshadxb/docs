# AI Agent Empire — Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ═══════════════════════════════════════════
# REQUIRED — Get from console.anthropic.com
# ═══════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ═══════════════════════════════════════════
# YOUR BUSINESS INFO — Customize these
# ═══════════════════════════════════════════
BUSINESS_NAME=Your Business Name
BUSINESS_NICHE=AI automation for entrepreneurs
TARGET_AUDIENCE=Small business owners who want to save time with AI
BRAND_VOICE=Practical, no-fluff, expert, slightly informal
WEBSITE_URL=https://yourbusiness.com
OWNER_NAME=Your Name
OWNER_EMAIL=you@yourbusiness.com

# ═══════════════════════════════════════════
# GMAIL (Agent 1 — Inbox Guardian)
# Get from: console.cloud.google.com
# ═══════════════════════════════════════════
GMAIL_CREDENTIALS_PATH=./credentials.json
VIP_EMAILS=client1@domain.com,client2@domain.com

# ═══════════════════════════════════════════
# SLACK (for alerts)
# Get from: api.slack.com/messaging/webhooks
# ═══════════════════════════════════════════
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/here

# ═══════════════════════════════════════════
# NOTION (Agent 2 — Content Engine)
# Get from: notion.so/my-integrations
# ═══════════════════════════════════════════
NOTION_API_KEY=secret_your_notion_key_here
NOTION_CONTENT_DB_ID=your_database_id_here

# ═══════════════════════════════════════════
# AIRTABLE (Agent 4 — Lead Nurture)
# Get from: airtable.com/create/tokens
# ═══════════════════════════════════════════
AIRTABLE_API_KEY=patYourAirtableKey
AIRTABLE_BASE_ID=appYourBaseId
AIRTABLE_LEADS_TABLE=Leads

# ═══════════════════════════════════════════
# CONTENT PILLARS (Agent 2 — Content Engine)
# ═══════════════════════════════════════════
PILLAR_1=AI automation for small business
PILLAR_2=Productivity tools and systems
PILLAR_3=Entrepreneurship and business growth
PILLAR_4=Success stories and case studies
PILLAR_5=Industry trends and AI news

# ═══════════════════════════════════════════
# ANALYTICS GOALS (Agent 6 — Analytics Oracle)
# ═══════════════════════════════════════════
MONTHLY_REVENUE_GOAL=10000
MONTHLY_LEADS_GOAL=200
MONTHLY_VISITORS_GOAL=5000
EMAIL_OPEN_RATE_GOAL=0.35
